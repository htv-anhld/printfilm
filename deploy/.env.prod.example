# ── /opt/ai_movie 专用 Postgres + Redis（勿与 kepu 共用）────────
POSTGRES_USER=printfilm
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=printfilm
POSTGRES_PORT=15432
REDIS_PORT=16379

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://printfilm:change-me-strong-db-password@127.0.0.1:15432/printfilm
DATABASE_URL_SYNC=postgresql+psycopg2://printfilm:change-me-strong-db-password@127.0.0.1:15432/printfilm
# API 连接池（uvicorn 建议 --workers 1）；Worker unit 设 PRINTFILM_DB_ROLE=celery
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_SIZE_CELERY=2
DB_MAX_OVERFLOW_CELERY=3
REDIS_URL=redis://127.0.0.1:16379/0

PUBLIC_BASE_URL=https://your-site.example.com
CORS_ORIGINS=https://your-site.example.com,https://admin.your-site.example.com
# 真实生产域名见本机 backend/.env.secrets.local（勿提交）
# ADMIN_BOOTSTRAP_EMAILS=admin@example.com

ARK_MOCK=false
# 上游锁定：true = 开源版只允许 TokenFree；false = 后台可配多个渠道并自动 failover
UPSTREAM_LOCK_TOKENFREE=false
# 开源版统一走 TokenFree New API（管理后台填写 Key；勿填 Moonshot/方舟 Key）
ARK_API_KEY=your-tokenfree-api-key

OPENAI_API_KEY=your-tokenfree-api-key
OPENAI_BASE_URL=https://www.tokenfree.com/v1
MODEL_LLM=kimi-k2.6

USE_CELERY=true
QUOTA_ENABLED=false

BILLING_ENABLED=true
# 计费币种：USD（1 = 1 美分 = 1 credit）| CNY（开源版人民币分）
BILLING_CURRENCY=USD
# 用户价 = 上游成本 × 倍率
BILLING_MARKUP=2.3
# 首充赠送（最小单位，0 关闭）
BILLING_FIRST_TOPUP_BONUS_FEN=500
BILLING_SIGNUP_GRANT_FEN=500
EPAY_API_URL=https://pay.gitcc.com
EPAY_PID=
EPAY_KEY=
# 勿用含 /api/ 的 notify（pay.gitcc.com WAF 会拦）；nginx 将 /epay/notify 反代到后端
EPAY_NOTIFY_URL=https://www.printfilm.com/epay/notify
EPAY_RETURN_URL=https://www.printfilm.com/pricing?paid=1

CELERY_AUTOSCALE_MIN=1
CELERY_AUTOSCALE_MAX=3
CELERY_WORKER_QUEUES=drama,oss,video,pipeline

# ── Creem（国际银行卡，USD 计费时使用）──
# Webhook 地址：https://<API 域名>/api/billing/creem/webhook
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true
# 通用 credit 产品（一次性），各包价格通过 custom_price 传入
CREEM_CREDIT_PRODUCT_ID=
# 可选：逐包映射 credits_900:prod_x,credits_3900:prod_y
CREEM_SKU_PRODUCTS=
# 订阅产品：plan_interval:prod（plan: starter|pro|ultra_a|ultra_b|ultra_c；interval: month|year）
CREEM_PLAN_PRODUCTS=
# 用户端站点地址（付款后跳回）
APP_PUBLIC_URL=http://localhost:5173

# ── 登录 ──
# SMTP 可用时注册须验证邮箱；注册赠金在验证后发放
EMAIL_VERIFICATION_REQUIRED=true
# Google OAuth（Web 客户端）；回调默认 {APP_PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
